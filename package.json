{
  "name": "oom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src",
    "build": "tsc -b && vite build && node scripts/generate-static-routes.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "npm run build",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "verify:pages": "node scripts/verify-pages-artifact.mjs",
    "tts:audit": "node scripts/audit-tts-inventory.mjs",
    "tts:generate": "node scripts/generate-static-tts.mjs",
    "tts:validate": "node scripts/validate-static-tts.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "kokoro-js": "1.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.14.1",
    "three": "^0.170.0",
    "wavesurfer.js": "7.12.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.7",
    "vitest": "^4.1.9"
  }
}
